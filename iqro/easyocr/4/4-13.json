{
  "content": [
    {
      "arabic": "يَتَنَازَعُونَ بَيْنَهُمُ",
      "latin": "YATANAAZA'UUNA BAINAHUMU",
      "order_id": 1,
      "position": {
        "col": 1,
        "row": 1
      }
    },
    {
      "arabic": "قُلُوبِهِم فِي غَمرَةٍ",
      "latin": "QULUUBIHIM FII GHOMROTIN",
      "order_id": 2,
      "position": {
        "col": 2,
        "row": 1
      }
    },
    {
      "arabic": "لَكُم دِينُكُم وَلِيَ دِينِ",
      "latin": "LAKUM DIINUKUM WALIYA DIINI",
      "order_id": 3,
      "position": {
        "col": 1,
        "row": 2
      }
    },
    {
      "arabic": "فَدَمدَمَ عَلَيهِمُ",
      "latin": "FADAMDAMA 'ALAIHIMU",
      "order_id": 4,
      "position": {
        "col": 2,
        "row": 2
      }
    },
    {
      "arabic": "إِذَا رَأَوهُم قَالُوا",
      "latin": "IDZAA RO'AWHUM QOOLUU",
      "order_id": 5,
      "position": {
        "col": 1,
        "row": 3
      }
    },
    {
      "arabic": "حَيثُ لَا تَرَونَهُمُ",
      "latin": "HAITSU LAA TAROWNAHUMU",
      "order_id": 6,
      "position": {
        "col": 2,
        "row": 3
      }
    },
    {
      "arabic": "لِبَاسُهُم فِيهِ حَرِيرٌ",
      "latin": "LIBAASUHUM FIIHI HARIIRUN",
      "order_id": 7,
      "position": {
        "col": 1,
        "row": 4
      }
    },
    {
      "arabic": "يَومَئِذٍ خَاشِعَةٌ",
      "latin": "YAWMA'IDZIN KHOOSYI'ATUN",
      "order_id": 8,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "جَاهَدُوا بِأَموَالِهِمُ",
      "latin": "JAAHADUU BI'AMWAALIHIMU",
      "order_id": 9,
      "position": {
        "col": 1,
        "row": 5
      }
    },
    {
      "arabic": "لَيسَ لَهُم طَعَامٌ",
      "latin": "LAISA LAHUM THO'AAMUN",
      "order_id": 10,
      "position": {
        "col": 2,
        "row": 5
      }
    },
    {
      "arabic": "أَفَحَصِيتَ أَمرِي",
      "latin": "AFAHASHIITA AMRII",
      "order_id": 11,
      "position": {
        "col": 1,
        "row": 6
      }
    },
    {
      "arabic": "صَلَوتِهِم يُحَافِظُونَ",
      "latin": "SHOLAWTIHIM YUHAAFIZHUUNA",
      "order_id": 12,
      "position": {
        "col": 2,
        "row": 6
      }
    },
    {
      "arabic": "يَتَخَافَتُونَ بَينَهُمُ",
