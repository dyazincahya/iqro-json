    },
    {
      "arabic": "وَالسَّمَاءِ وَالطَّارِقِ ○",
      "latin": "WASSAMAA'I WATHTHOORIQI ○",
      "order_id": 13,
      "position": {
        "col": 1,
        "row": 4
      }
    },
    {
      "arabic": "وَمَا أَدرَاكَ مَا الطَّارِقُ ○",
      "latin": "WAMAA ADROOKA MAATHTHOORIQU ○",
      "order_id": 14,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "وَإِذَا الجَحِيمُ سُعِّرَت ○",
      "latin": "WA'IDZAA ALJAHIIMU SU''IROT ○",
      "order_id": 15,
      "position": {
        "col": 1,
        "row": 5
      }
    },
    {
      "arabic": "وَإِذَا الجَنَّةُ أُزلِفَت ○",
      "latin": "WA'IDZAA ALJANNATU UZLIFAT ○",
      "order_id": 16,
      "position": {
        "col": 2,
        "row": 5
      }
    },
    {
      "arabic": "وَمَا هُم عَنهَا بِغَائِبِينَ ○",
      "latin": "WAMAA HUM 'ANHAA BIGHOO'IBIINA ○",
      "order_id": 17,
      "position": {
        "col": 1,
        "row": 6
      }
    },
    {
      "arabic": "إِنَّ الَّذِينَ يَغُضُّونَ أَصوَاتَهُم ○",
      "latin": "INNA ALLADZIINA YAGHUDHDHUUNA ASHWAATAHUM ○",
      "order_id": 18,
      "position": {
        "col": 2,
        "row": 6
      }
    },
    {
      "arabic": "وَالحَقُّنِي بِالصَّالِحِينَ ○",
      "latin": "WALHAQQNII BISHSHOOLIHIINA ○",
      "order_id": 19,
      "position": {
        "col": 1,
        "row": 7
      }
    },
    {
      "arabic": "وَإِنَّهُ لَمِنَ الصَّادِقِينَ ○",
      "latin": "WA'INNAHU LAMINA ASHSHAADIQIINA ○",
      "order_id": 20,
      "position": {
        "col": 2,
        "row": 7
      }
    },
    {
      "arabic": "وَبِئسَ مَثوَى الظَّالِمِينَ ○",
      "latin": "WABI'SA MATSWAA AZHZHOOLIMIINA ○",
      "order_id": 21,
      "position": {
        "col": 1,
        "row": 8
      }
    },
    {
      "arabic": "وَالسَّوءُ عَلَى الكَافِرِينَ ○",
