{
  "content": [
    {
      "arabic": "وَقَومَهُمَا لَنَا عَابِدُون ○",
      "latin": "WAQOUMAHUMAA LANAA 'AABIDUUNA ○",
      "order_id": 1,
      "position": {
        "col": 1,
        "row": 1
      }
    },
    {
      "arabic": "وَمَا بَينَهُمَا لَعِبِين ○",
      "latin": "WAMAA BAINAHUMAA LA'IBIINA ○",
      "order_id": 2,
      "position": {
        "col": 2,
        "row": 1
      }
    },
    {
      "arabic": "ذَلِكَ الفَوزُ العَظِيم ○",
      "latin": "DZAALIKA ALFAUZU AL'AZHIIMU ○",
      "order_id": 3,
      "position": {
        "col": 1,
        "row": 2
      }
    },
    {
      "arabic": "كَذَلِكَ نَجزِي المُحسِنِين ○",
      "latin": "KADZAALIKA NAJZII ALMUHSINIINA ○",
      "order_id": 4,
      "position": {
        "col": 2,
        "row": 2
      }
    },
    {
      "arabic": "وَهُم لَا يَشعُرُون ○",
      "latin": "WAHUM LAA YASY'URUUNA ○",
      "order_id": 5,
      "position": {
        "col": 1,
        "row": 3
      }
    },
    {
      "arabic": "هُم فِيهَا خَالِدُون ○",
      "latin": "HUM FIIHAA KHOOLIDUUNA ○",
      "order_id": 6,
      "position": {
        "col": 2,
        "row": 3
      }
    },
    {
      "arabic": "فِي العَذَابِ مُشترِكُون ○",
      "latin": "FII AL'ADZAABI MUSYTARIKUUNA ○",
      "order_id": 7,
      "position": {
        "col": 1,
        "row": 4
      }
    },
    {
      "arabic": "مَا لَكُم لَا تَنَاصَرُون ○",
      "latin": "MAA LAKUM LAA TANAASHORUUNA ○",
      "order_id": 8,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "وَأَكثَرُهُم الفَاسِقُون ○",
      "latin": "WA'AKTSARUHUM ALFAASIQUUNA ○",
      "order_id": 9,
      "position": {
        "col": 1,
        "row": 5
      }
    },
    {
      "arabic": "فَمَا لَهُم لَا يُؤمِنُون ○",
      "latin": "FAMAA LAHUM LAA YU'MINUUNA ○",
      "order_id": 10,
      "position": {
        "col": 2,
        "row": 5
      }
    },
    {
      "arabic": "اعلَمُوا مَا لَا تَعلَمُون ○",
      "latin": "A'LAMUU MAA LAA TA'LAMUUNA ○",
      "order_id": 11,
      "position": {
        "col": 1,
        "row": 6
      }
    },
    {
      "arabic": "مِن حَيثُ لَا يَشعُرُون ○",
      "latin": "MIN HAITSU LAA YASY'URUUNA ○",
      "order_id": 12,
      "position": {
        "col": 2,
        "row": 6
      }
    },
    {
      "arabic": "ذُو الجَلَالِ وَالإِكرَام ○",
      "latin": "DZUU ALJALAALI WALIKROOMI ○",
      "order_id": 13,
      "position": {
        "col": 1,
        "row": 7
      }
    },
    {
      "arabic": "وَتَوَاصَوا بِالمَرحَمَة ○",
      "latin": "WATAWAASHOU BILMARHAMATI ○",
      "order_id": 14,
      "position": {
        "col": 2,
        "row": 7
      }
    },
    {
      "arabic": "إِرَمَ ذَاتَ العِمَاد ○",
      "latin": "IROMA DZAATA AL'IMAADI ○",
      "order_id": 15,
      "position": {
        "col": 1,
        "row": 8
      }
    },
    {
      "arabic": "وَفِرعَونَ ذِي الأَوتَاد ○",
      "latin": "WAFIR'AUNA DZII ALAUTAADI ○",
      "order_id": 16,
      "position": {
        "col": 2,
        "row": 8
      }
    }
  ],
