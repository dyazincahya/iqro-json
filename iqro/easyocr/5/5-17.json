      "position": {
        "col": 1,
        "row": 4
      }
    },
    {
      "arabic": "عَلَى سُرُرٍ مُّتَقَابِلِينَ ○",
      "latin": "'ALAA SURURIN MUTAQOOBILIINA ○",
      "order_id": 14,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "وَلَقَد مَكَّنَّاهُم فِيمَا ○",
