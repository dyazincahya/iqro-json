      "order_id": 17,
      "position": {
        "col": 1,
        "row": 6
      }
    },
    {
      "arabic": "عَبدًا إِذَا صَلَّى ○",
      "latin": "'ABDAN IDZAA SHOLLAA ○",
      "order_id": 18,
      "position": {
        "col": 2,
        "row": 6
      }
    },
    {
      "arabic": "حَقًّا عَلَى المُحسِنِينَ ○",
