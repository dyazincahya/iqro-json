      "order_id": 5,
      "position": {
        "col": 2,
        "row": 2
      }
    },
    {
      "arabic": "وَالنَّازِعَاتِ غَرقًا ○",
      "latin": "WANNA AZI'AATI GHORQON ○",
      "order_id": 6,
      "position": {
        "col": 1,
        "row": 3
      }
    },
    {
      "arabic": "وَالنَّاشِطَاتِ نَشطًا ○",
      "latin": "WANNASYITHOOTI NASYTHON ○",
      "order_id": 7,
      "position": {
        "col": 2,
        "row": 3
      }
    },
    {
      "arabic": "وَكُنَّا نَخوضُ مَعَ الخَائِضِينَ ○",
      "latin": "WAKUNNAA NAKHUUDHU MA'A ALKHOAIDHIINA ○",
      "order_id": 8,
      "position": {
        "col": 1,
        "row": 4
      }
    },
    {
      "arabic": "أَم كَانَ مِنَ الغَائِبِينَ ○",
      "latin": "AM KAANA MINA ALGHOO'IBIINA ○",
      "order_id": 9,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "إِنِّي لَكُم نَذِيرٌ مُّبِينٌ ○",
      "latin": "INNII LAKUM NADZIIRUN MUBIINUN ○",
      "order_id": 10,
      "position": {
        "col": 1,
        "row": 5
      }
    },
    {
      "arabic": "وَمَا لَكُم مِّن نَّاصِرِينَ ○",
      "latin": "WAMAA LAKUM MIN NAASHIRIINA ○",
      "order_id": 11,
      "position": {
        "col": 2,
        "row": 5
      }
    },
    {
      "arabic": "عَمَّ يَتَسَاءَلُونَ ○",
      "latin": "'AMMA YATASAA'ALUUNA ○",
      "order_id": 12,
      "position": {
        "col": 1,
        "row": 6
      }
    },
    {
      "arabic": "عَنِ النَّبَإِ العَظِيمِ ○",
      "latin": "'ANI ANNABA'I AL'AZHIIMI ○",
      "order_id": 13,
      "position": {
        "col": 2,
        "row": 6
      }
    },
    {
      "arabic": "إِذَا كُنَّا عِظَامًا نَّخِرَةً ○",
      "latin": "IDZAA KUNNAA 'IZHOOMAN NAKHIROTAN ○",
