      "order_id": 8,
      "position": {
        "col": 2,
        "row": 4
      }
    },
    {
      "arabic": "وَهُوَ يَعِظُهُ",
      "latin": "WAHUWA YA'IZHUHU",
      "order_id": 9,
      "position": {
        "col": 1,
        "row": 5
      }
    },
    {
